{
  "name": "flashbang",
  "productName": "Flashbang",
  "version": "1.0.0",
  "description": "Desktop Coordinate Screenshot to PDF & ZIP Tool",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:all": "npm run build && npm run build:electron",
    "start": "concurrently -k \"tsc -p tsconfig.electron.json -w --preserveWatchOutput\" \"vite\" \"wait-on tcp:5173 && electron .\"",
    "start:dist": "npm run build:all && cross-env NODE_ENV=production electron .",
    "dist": "npm run build:all && electron-builder --win",
    "dist:portable": "npm run build:all && electron-builder --win portable",
    "dist:dir": "npm run build:all && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.asquilatan.flashbang",
    "productName": "Flashbang",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "media/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sql.js/dist/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "media/icon_taskbar.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Flashbang"
    }
  },
  "keywords": [
    "screenshot",
    "electron",
    "pdf",
    "coordinates"
  ],
  "author": "asquilatan",
  "license": "MIT",
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide-react": "^0.395.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.10.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.2",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  }
}
